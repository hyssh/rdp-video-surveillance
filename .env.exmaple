AZURE_TEXT_EMBEDDING_APIKEY=
AZURE_TEXT_EMBEDDING_API_VERSION="2024-12-01-preview"
AZURE_AI_AGENT_ENDPOINT="https://####.services.ai.azure.com/api/projects/#####"
AZURE_AI_AGENT_API_VERSION="2025-01-01-preview"
AZURE_AI_AGENT_SUBSCRIPTION_ID="####"
AZURE_AI_AGENT_RESOURCE_GROUP_NAME="####"
AZURE_AI_AGENT_PROJECT_NAME="####"
PG_CONNECTION_STRING="cnx = psycopg2.connect(user='####', password='####', host='####.postgres.database.azure.com', port=5432, database='postgres')"
PGHOST=####.postgres.database.azure.com
PGUSER=####
PGPORT=5432
PGDATABASE=postgres
