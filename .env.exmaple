AZURE_OPENAI_CHAT_DEPLOYMENT_NAME="gpt-6.1-sol"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME="text-embedding-3-large"
# Vector size stored in Postgres. text-embedding-3-large = 3072 (default); ada-002 = 1536.
# Changing it migrates frames.embedding (existing embeddings are reset to NULL).
EMBEDDING_DIMENSIONS=3072
AZURE_OPENAI_ENDPOINT="https://####.openai.azure.com/"
AZURE_OPENAI_API_VERSION="2024-12-01-preview"
AZURE_OPENAI_APIKEY=
# Authentication: leave the API keys empty to use Microsoft Entra ID (DefaultAzureCredential):
# either `az login` (local), a managed identity, or the service principal vars below.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=
