# Variant of .env.example for docker compose (see .env.example for per-variable comments).
# Use with: docker compose --env-file .env.docker up   (or copy to .env)
OMNIPARSER_ENABLE=True
CHAT_COMPLETION_ENABLE=True
SOM_MODEL_PATH=weights/icon_detect/model.pt
CAPTION_MODEL_NAME=florence2
CAPTION_MODEL_PATH=weights/icon_caption_florence
DEVICE=cuda
BOX_THRESHOLD=0.05
OMNIPARSER_HOST=0.0.0.0
OMNIPARSER_PORT=8081
# Scalability / resilience tuning knobs (optional; defaults shown, see .env.example)
MAX_CONCURRENT_OMNIPARSER=2
MAX_CONCURRENT_JOBS=2
OMNIPARSER_MAX_CONCURRENCY=1
OMNIPARSER_ACQUIRE_TIMEOUT_SECONDS=5
OMNIPARSER_RETRY_AFTER_SECONDS=5
OMNIPARSER_CONNECT_TIMEOUT=5
OMNIPARSER_READ_TIMEOUT=120
HEALTHCHECK_CONNECT_TIMEOUT=3
HEALTHCHECK_READ_TIMEOUT=5
EMBEDDING_BATCH_SIZE=16
RETRY_MAX_ATTEMPTS=4
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=30
AZURE_STORAGE_CONNECTION_STRING=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_CHAT_COMPLETION_MODEL=gpt-4o
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
PGHOST=
PGUSER=
PGPORT=5432
PGDATABASE=postgres
PGPASSWORD=
