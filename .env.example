# Copy to .env and fill in the placeholders (never commit .env).
# Used by docker-compose.yml (variable substitution) and by `python src/...` when run locally.

# --- Feature switches (orchestrator) ---
# False = send raw frames to the LLM without OmniParser
OMNIPARSER_ENABLE=True
# False disables LLM analysis (ingest will return an error)
CHAT_COMPLETION_ENABLE=True

# --- OmniParser service (src/omniparser/server.py) ---
SOM_MODEL_PATH=weights/icon_detect/model.pt
CAPTION_MODEL_NAME=florence2
CAPTION_MODEL_PATH=weights/icon_caption_florence
# cuda or cpu
DEVICE=cuda
BOX_THRESHOLD=0.05
# Where the orchestrator (and test/test.py) reaches OmniParser.
# Local run: 127.0.0.1. docker compose overrides this to the service name "omniparser".
OMNIPARSER_HOST=127.0.0.1
OMNIPARSER_PORT=8081

# --- Scalability / resilience tuning knobs (all optional; defaults shown) ---
# Max frames sent to OmniParser concurrently by the orchestrator.
MAX_CONCURRENT_OMNIPARSER=2
# Max ingestion jobs the orchestrator runs at the same time (extra jobs wait in "queued").
MAX_CONCURRENT_JOBS=2
# Max concurrent inference requests accepted by the OmniParser server (GPU memory bound).
# Excess requests wait OMNIPARSER_ACQUIRE_TIMEOUT_SECONDS, then get HTTP 429 + Retry-After.
OMNIPARSER_MAX_CONCURRENCY=1
OMNIPARSER_ACQUIRE_TIMEOUT_SECONDS=5
OMNIPARSER_RETRY_AFTER_SECONDS=5
# Orchestrator -> OmniParser HTTP timeouts (seconds) and /healthcheck timeouts.
OMNIPARSER_CONNECT_TIMEOUT=5
OMNIPARSER_READ_TIMEOUT=120
HEALTHCHECK_CONNECT_TIMEOUT=3
HEALTHCHECK_READ_TIMEOUT=5
# Frames per embedding request.
EMBEDDING_BATCH_SIZE=16
# Retry/backoff for Azure OpenAI calls.
RETRY_MAX_ATTEMPTS=4
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=30

# --- Azure Blob Storage (videos and extracted frames) ---
# Either a connection string (key auth) OR just the account name (Entra ID: az login / service principal /
# managed identity; needs the "Storage Blob Data Contributor" role). The connection string wins when both are set.
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=####;AccountKey=####;EndpointSuffix=core.windows.net"
# AZURE_STORAGE_ACCOUNT_NAME=####

# --- Azure OpenAI via Microsoft Agent Framework (chat/vision agents + embeddings) ---
# Leave AZURE_OPENAI_API_KEY empty to sign in with Entra ID (DefaultAzureCredential, e.g. `az login`).
# Service principal: set AZURE_CLIENT_ID / AZURE_TENANT_ID / AZURE_CLIENT_SECRET. Managed identity needs nothing.
# Older names still work as fallbacks: AZURE_OPENAI_APIKEY, AZURE_OPENAI_CHAT_DEPLOYMENT_NAME,
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME, AZURE_AI_AGENT_CHAT_MODEL_DEPLOYMENT_NAME,
# AZURE_AI_AGENT_EMBEDDING_MODEL_DEPLOYMENT_NAME.
AZURE_OPENAI_ENDPOINT="https://####.openai.azure.com/"
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_API_VERSION="2024-12-01-preview"
AZURE_OPENAI_CHAT_COMPLETION_MODEL="gpt-6.1-sol"
AZURE_OPENAI_EMBEDDING_MODEL="text-embedding-3-large"
# Size of frames.embedding (pgvector). Must match the embedding model output: text-embedding-3-large = 3072
# (text-embedding-ada-002 = 1536). Changing it migrates the column and resets stored embeddings to NULL.
EMBEDDING_DIMENSIONS=3072
# Optional sampling overrides (leave unset for reasoning models such as gpt-6.1-sol)
# LLM_TEMPERATURE=0.1
# LLM_TOP_P=0.1
# Entra ID service principal (optional)
# AZURE_CLIENT_ID=####
# AZURE_TENANT_ID=####
# AZURE_CLIENT_SECRET=####
# Optional: Azure AI Foundry project endpoint (reserved; the orchestrator calls Azure OpenAI directly)
# AZURE_AI_AGENT_ENDPOINT="https://####.services.ai.azure.com/api/projects/####"
# Optional: only if embeddings use a different Azure OpenAI resource than chat
# AZURE_TEXT_EMBEDDING_ENDPOINT="https://####.openai.azure.com/"
# AZURE_TEXT_EMBEDDING_APIKEY="####"

# --- Azure PostgreSQL (needs the pgvector extension) ---
PGHOST=####.postgres.database.azure.com
PGUSER=####
PGPORT=5432
PGDATABASE=postgres
PGPASSWORD="####"
# require (default, Azure PostgreSQL) | disable (local pgvector container)
PGSSLMODE=require
