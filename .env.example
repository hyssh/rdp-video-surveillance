# Copy to .env and fill in the placeholders (never commit .env).
# Used by docker-compose.yml (variable substitution) and by `python src/...` when run locally.

# --- Feature switches (orchestrator) ---
# False = send raw frames to the LLM without OmniParser
OMNIPARSER_ENABLE=True
# False disables LLM analysis (ingest will return an error)
CHAT_COMPLETION_ENABLE=True

# --- OmniParser service (src/omniparser/server.py) ---
SOM_MODEL_PATH=weights/icon_detect/model.pt
CAPTION_MODEL_NAME=florence2
CAPTION_MODEL_PATH=weights/icon_caption_florence
# cuda or cpu
DEVICE=cuda
BOX_THRESHOLD=0.05
# Where the orchestrator (and test/test.py) reaches OmniParser.
# Local run: 127.0.0.1. docker compose overrides this to the service name "omniparser".
OMNIPARSER_HOST=127.0.0.1
OMNIPARSER_PORT=8081

# --- Scalability / resilience tuning knobs (all optional; defaults shown) ---
# Max frames sent to OmniParser concurrently by the orchestrator.
MAX_CONCURRENT_OMNIPARSER=2
# Max concurrent inference requests accepted by the OmniParser server (GPU memory bound).
# Excess requests wait OMNIPARSER_ACQUIRE_TIMEOUT_SECONDS, then get HTTP 429 + Retry-After.
OMNIPARSER_MAX_CONCURRENCY=1
OMNIPARSER_ACQUIRE_TIMEOUT_SECONDS=5
OMNIPARSER_RETRY_AFTER_SECONDS=5
# Orchestrator -> OmniParser HTTP timeouts (seconds) and /healthcheck timeouts.
OMNIPARSER_CONNECT_TIMEOUT=5
OMNIPARSER_READ_TIMEOUT=120
HEALTHCHECK_CONNECT_TIMEOUT=3
HEALTHCHECK_READ_TIMEOUT=5
# Frames per embedding request.
EMBEDDING_BATCH_SIZE=16
# Retry/backoff for Azure OpenAI calls.
RETRY_MAX_ATTEMPTS=4
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=30

# --- Azure Blob Storage (videos and extracted frames) ---
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=####;AccountKey=####;EndpointSuffix=core.windows.net"

# --- Azure OpenAI: chat / vision (image analyzer + security reviewer agents) ---
AZURE_OPENAI_ENDPOINT="https://####.openai.azure.com/"
AZURE_OPENAI_APIKEY="####"
AZURE_OPENAI_API_VERSION="2024-12-01-preview"
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME="gpt-4.1"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME="text-embedding-ada-002"

# --- Azure OpenAI: text embeddings (stored in PostgreSQL pgvector) ---
AZURE_TEXT_EMBEDDING_ENDPOINT="https://####.openai.azure.com/"
AZURE_TEXT_EMBEDDING_APIKEY="####"
AZURE_TEXT_EMBEDDING_API_VERSION="2024-12-01-preview"

# --- Model deployment names read by app.py ---
AZURE_AI_AGENT_CHAT_MODEL_DEPLOYMENT_NAME="gpt-4.1"
AZURE_AI_AGENT_EMBEDDING_MODEL_DEPLOYMENT_NAME="text-embedding-ada-002"

# --- Azure PostgreSQL (needs the pgvector extension) ---
PGHOST=####.postgres.database.azure.com
PGUSER=####
PGPORT=5432
PGDATABASE=postgres
PGPASSWORD="####"

# --- Azure AI Foundry agent settings (only referenced by currently commented-out agent code; optional) ---
AZURE_AI_AGENT_PROJECT_CONNECTION_STRING="eastus.api.azureml.ms;####"
AZURE_AI_AGENT_MODEL_DEPLOYMENT_NAME="gpt-4.1"
AZURE_AI_AGENT_REASONING_MODEL_DEPLOYMENT_NAME="o3"
AZURE_AI_AGENT_ENDPOINT="https://####.services.ai.azure.com/api/projects/#####"
AZURE_AI_AGENT_API_VERSION="2025-01-01-preview"
AZURE_AI_AGENT_SUBSCRIPTION_ID="####"
AZURE_AI_AGENT_RESOURCE_GROUP_NAME="####"
AZURE_AI_AGENT_PROJECT_NAME="####"
